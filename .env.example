# Copy to .env and fill in. Never commit the real .env -- it holds secrets.
# On the VPS this file lives at /docker/shortbridge/.env with chmod 600.

# --- Core ---
BASE_URL=https://shortbridge.srv1006990.hstgr.cloud
TIMEZONE=America/Santiago
# true until you're ready for TikTok to actually receive uploads (section 35)
DRY_RUN=true
COOKIE_SECURE=true

# --- Secrets: generate with scripts/generate_keys.py, then paste here and
# never regenerate without a plan (rotating APP_SECRET_KEY logs everyone
# out; rotating APP_ENCRYPTION_KEY makes existing encrypted tokens
# unreadable -- you'd need to reconnect YouTube/TikTok) ---
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=

# --- Admin login: generate the hash with scripts/hash_password.py ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Google / YouTube (Phase 2 -- see GOOGLE_OAUTH_SETUP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok (Phase 4 -- see TIKTOK_SETUP.md) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Scheduler ---
YOUTUBE_SYNC_INTERVAL_HOURS=6

# --- Unofficial YouTube download (yt-dlp) -- OFF by default. Read
# UNOFFICIAL_DOWNLOAD.md before setting this true: not Google's API,
# against YouTube's ToS, can break without warning. ---
ENABLE_YOUTUBE_UNOFFICIAL_DOWNLOAD=false
YOUTUBE_DOWNLOAD_INTERVAL_SECONDS=15
YOUTUBE_DOWNLOAD_RETRY_AFTER_HOURS=6
